    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "discipline",
      "label": "The discipline — evidence before any edit"
    },
    {
      "id": "stuck",
      "label": "Stuck Escalation",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "observe",
      "label": "Observe first",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "diagnose",
      "label": "Diagnose with evidence",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "prove",
      "label": "Fix + verify",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "reproduce",
    "read",
    "localize",
    "hypothesis",
    "fix",
    "verify"
