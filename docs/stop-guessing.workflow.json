      "id": "reproduce",
      "lane": "discipline",
      "col": 0,
      "type": "backend",
      "label": "Reproduce",
      "sublabel": "observe, never assume",
      "width": 108
    },
    {
      "id": "read",
      "lane": "discipline",
      "col": 1,
      "type": "backend",
      "label": "Read Full Error",
      "sublabel": "crash site ≠ cause",
      "width": 126
    },
    {
      "id": "localize",
      "lane": "discipline",
      "col": 2,
      "type": "backend",
      "label": "Localize",
      "sublabel": "follow the data",
      "width": 108
    },
    {
      "id": "hypothesis",
      "lane": "discipline",
      "col": 3,
      "type": "security",
